        <button class="btn-load" id="geo-load-3d">加载</button>
        <button class="btn-clear" id="geo-clear-3d">移除</button>
      </div>
      <div id="geo-height-sec" style="display:none;">
        <div class="sec-title">🕹️ 高度修正</div>
